# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
# Set to true to log to console only (useful for local runs)
# Set to false to log to both console and a daily log file
LOG_TO_CONSOLE=

# ---------------------------------------------------------------------------
# Azure AI Foundry — project endpoint & credentials
# ---------------------------------------------------------------------------
PROJECT_ENDPOINT=
AZURE_AI_API_KEY=

# Agent identifiers (name and version as deployed in Foundry)
# Support Email Intent Classifier
AGENT_ID_DETERMINE_THE_EMAIL_INTENT=
AGENT_VERSION_DETERMINE_THE_EMAIL_INTENT=

# ---------------------------------------------------------------------------
# MCP server endpoints
# ---------------------------------------------------------------------------
# myemailmcpserver
MCP_MYEMAILMCPSERVER_ENDPOINT=

# ---------------------------------------------------------------------------
