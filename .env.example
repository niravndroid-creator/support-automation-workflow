# (one container per workflow; partitioned by date; one document per run)
# ---------------------------------------------------------------------------
COSMOS_DB_ENDPOINT=
COSMOS_DB_DATABASE=
COSMOS_DB_KEY=
WORKFLOW_ID=
WORKFLOW_NAME=


